# Copy this file to .env.local and replace placeholders with local values.
# .env.local is ignored by Git; never commit real credentials.

# Base self-hosted stack
STELE_POSTGRES_PASSWORD=replace-with-local-password
STELE_DATABASE_MIGRATION_POLICY=auto
STELE_AUTH_BOOTSTRAP_ADMIN_KEY=replace-with-bootstrap-secret
STELE_AUTH_DEFAULT_TENANT=tenant-a
STELE_AUTH_DEFAULT_PROJECT=project-a
STELE_AUTH_DEFAULT_NAMESPACE=namespace-a

# Optional embedding provider (leave unset for lexical-only mode).
STELE_EMBEDDING_DEFAULT_PROVIDER=
STELE_EMBEDDING_DEFAULT_MODEL=
STELE_EMBEDDING_DEFAULT_DIMENSIONS=
STELE_EMBEDDING_CLASS_ROUTES=
STELE_EMBEDDING_OPENAI_API_KEY=
STELE_EMBEDDING_OPENAI_BASE_URL=https://api.openai.com/v1
STELE_EMBEDDING_OPENAI_TIMEOUT=30s

# Optional reranker (disabled by default; use shadow before active_for_scope).
STELE_RERANK_ENABLED=false
STELE_RERANK_MODE=shadow
STELE_RERANK_PROVIDER=
STELE_RERANK_ENDPOINT=
STELE_RERANK_MODEL=
STELE_RERANK_API_KEY=
STELE_RERANK_TIMEOUT=30s
STELE_RERANK_MAX_CANDIDATES=50
STELE_RERANK_MAX_TEXT_BYTES=8192
