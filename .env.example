# Local evaluation defaults only. Use an external secret mechanism in production.
STELE_POSTGRES_PASSWORD=replace-with-local-password
STELE_DATABASE_MIGRATION_POLICY=auto
STELE_AUTH_BOOTSTRAP_ADMIN_KEY=replace-with-bootstrap-secret
STELE_AUTH_DEFAULT_TENANT=tenant-a
STELE_AUTH_DEFAULT_PROJECT=project-a
STELE_AUTH_DEFAULT_NAMESPACE=namespace-a

# Optional reranker (disabled by default; inject secrets at runtime only).
STELE_RERANK_ENABLED=false
STELE_RERANK_MODE=shadow
STELE_RERANK_PROVIDER=
STELE_RERANK_ENDPOINT=
STELE_RERANK_MODEL=
STELE_RERANK_API_KEY=
STELE_RERANK_TIMEOUT=30s
STELE_RERANK_MAX_CANDIDATES=50
STELE_RERANK_MAX_TEXT_BYTES=8192
